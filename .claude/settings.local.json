{
  "permissions": {
    "allow": [
      "Bash(py --version)",
      "Bash(where python *)",
      "Bash(where py *)",
      "Bash(where node *)",
      "Bash(where npx *)",
      "PowerShell(Get-NetTCPConnection -LocalPort 8813 -ErrorAction SilentlyContinue)",
      "PowerShell(Get-CimInstance Win32_Process -Filter \"Name='powershell.exe'\")",
      "PowerShell(Get-Process -Id 19952 -ErrorAction SilentlyContinue)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8813/index.html)",
      "Bash(curl -s http://localhost:8813/index.html)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8813/faq.html)",
      "Bash(curl -s -o /dev/null -w \" %{http_code}\" http://localhost:8813/faq.html)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8813/tokushoho.html)",
      "Bash(curl -s -o /dev/null -w \" %{http_code}\" http://localhost:8813/index.html)",
      "Bash(curl -s -o /dev/null -w \"index:%{http_code} \" http://localhost:8813/index.html)",
      "Bash(curl -s -o /dev/null -w \"faq:%{http_code} \" http://localhost:8813/faq.html)",
      "Bash(curl -s -o /dev/null -w \"tokushoho:%{http_code} \" http://localhost:8813/tokushoho.html)",
      "Bash(curl -s -o /dev/null -w \"blog:%{http_code} \" http://localhost:8813/blog.html)",
      "Bash(curl -s -o /dev/null -w \"blog-vol1:%{http_code}\\\\n\" http://localhost:8813/blog-vol1-report.html)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8813/blog.html)",
      "Bash(curl -s http://localhost:8813/sitemap.xml)",
      "Bash(curl -s http://localhost:8813/robots.txt)"
    ]
  }
}
